# Production — Vercel → Settings → Environment Variables
# Frontend site: https://societysimplify.vercel.app
# Point these at your AWS API hosts (must end with /api/v1). Keep your current working
# identity/core URLs until you cut over DNS — do not invent Vercel subdomains for APIs.

VITE_IDENTITY_URL=https://YOUR_IDENTITY_API_HOST/api/v1
VITE_CORE_URL=https://YOUR_CORE_API_HOST/api/v1

# Temporary (before custom API DNS), if you expose ports via Elastic IP + Caddy path routing:
# VITE_IDENTITY_URL=http://YOUR_EC2_IP/identity/api/v1
# VITE_CORE_URL=http://YOUR_EC2_IP/core/api/v1
