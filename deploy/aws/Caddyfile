# SocietySimplify API reverse proxy on EC2 Elastic IP (path-based).
# Vercel rewrites /identity/* and /core/* → this host so the site stays on
# https://societysimplify.vercel.app with no old brand DNS names.

:80 {
	encode gzip

	handle_path /identity* {
		reverse_proxy identity:8081
	}

	handle_path /core* {
		reverse_proxy core:8082
	}
}
