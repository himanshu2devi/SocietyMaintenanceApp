# SocietySimplify API reverse proxy on EC2 (path-based; no brand hostnames).
# Vercel rewrites /identity/* and /core/* to this host so the browser stays on
# https://societysimplify.vercel.app (avoids mixed-content and old DNS names).

:80 {
	encode gzip

	handle_path /identity* {
		reverse_proxy identity:8081
	}

	handle_path /core* {
		reverse_proxy core:8082
	}
}
