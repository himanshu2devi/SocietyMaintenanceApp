# Replace hostnames with your real API DNS (A records to EC2 Elastic IP).
# Do NOT use *.vercel.app for APIs — Vercel hosts the React frontend only.
# Example once DNS is ready: identity.yourdomain.com / core.yourdomain.com

identity.example.com {
	encode gzip
	reverse_proxy identity:8081
}

core.example.com {
	encode gzip
	reverse_proxy core:8082
}

